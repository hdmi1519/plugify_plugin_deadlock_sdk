      "paramTypes": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "flags",
          "type": "int64"
        },
        {
          "name": "callback",
          "type": "function",
          "prototype": "CommandCallback"
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
